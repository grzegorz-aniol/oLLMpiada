{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(pnpm --dir frontend install)",
      "Bash(pnpm --dir frontend install *)",
      "Bash(pnpm --dir frontend add *)",
      "Bash(pnpm --dir frontend remove *)",
      "Bash(pnpm --dir frontend run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
